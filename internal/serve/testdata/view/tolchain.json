      "errors": [
        "ErrInsufficientBalance",
        "ErrUnauthorized",
        "ErrBalanceOverflow"
      ],
      "satisfies": [
        "REQ-transfer"
      ],
      "cases": [
        {
          "name": "금액 0",
          "given": {
            "amount": 0
          },
          "expect": null,
          "error": "invalid"
        },
        {
          "name": "잔액 부족",
          "given": {
            "amount": 10,
            "balance": 5
          },
          "expect": null,
          "error": "ErrInsufficientBalance"
        },
        {
          "name": "위임 한도 초과",
          "given": {
            "amount": 10,
            "delegated_max": 5
          },
          "expect": null,
          "error": "ErrUnauthorized"
        },
        {
          "name": "정상 이체",
          "given": {
            "amount": 3,
            "balance": 10
          },
          "expect": {
            "from": 7,
            "to": 3
          },
          "error": ""
        }
      ]
    }
