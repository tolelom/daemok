{
  "goModule": "github.com/tolelom/tolchain",
  "system": {
    "id": "tolchain",
    "summary": "게임 특화 PoA 프라이빗 블록체인"
  },
  "tiers": [
    "foundation",
    "domain",
    "persistence",
    "execution",
    "service"
  ],
  "reqs": [
    {
      "id": "REQ-transfer",
      "text": "사용자는 토큰을 다른 주소로 보낼 수 있다",
      "status": "active"
    },
    {
      "id": "REQ-reward",
      "text": "게임 서버는 보상을 한 트랜잭션으로 모아 지급한다",
      "status": "active"
    },
    {
      "id": "REQ-delegation",
      "text": "API 서버는 위임받은 범위 안에서 유저 대신 서명한다",
      "status": "active"
    },
    {
      "id": "REQ-random",
      "text": "게임 난수는 commit-reveal로 조작을 막는다",
      "status": "held"
    }
  ],
  "actors": [
    {
      "id": "game_server",
      "summary": "게임 결과를 서명된 트랜잭션으로 제출"
    },
    {
      "id": "api_server",
      "summary": "커스터디얼 지갑으로 유저 대신 서명"
    },
    {
      "id": "peer_node",
      "summary": "다른 tolchain 노드"
    },
    {
      "id": "monitoring",
      "summary": "Prometheus + Grafana"
    }
  ],
  "ifaces": [
    {
      "id": "json_rpc",
      "protocol": "jsonrpc2-http",
      "port": 8545,
      "path": null,
      "spec": "",
      "used_by": [
